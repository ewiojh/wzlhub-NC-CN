-- ⚡ 关键突破：手势精准隔离 (防误触拖动)
local draggingCapsule = false
local dragStartPos = Vector3.new()
local capsuleStartUDim = UDim2.new()
local totalDragDistance = 0

GlassCapsule.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingCapsule = true
        dragStartPos = input.Position
        capsuleStartUDim = GlassCapsule.Position
        totalDragDistance = 0

        -- 按压微缩手感反馈
        TweenService:Create(GlassCapsule, TweenInfo.new(0.12), {
            Size = UDim2.new(0, 62, 0, 30)
        }):Play()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingCapsule and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartPos
        totalDragDistance = delta.Magnitude -- 实时记录手势移动的绝对距离

        GlassCapsule.Position = UDim2.new(
            capsuleStartUDim.X.Scale, 
            capsuleStartUDim.X.Offset + delta.X, 
            capsuleStartUDim.Y.Scale, 
            capsuleStartUDim.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if not draggingCapsule then return end
        draggingCapsule = false

        -- 还原按压尺寸
        TweenService:Create(GlassCapsule, TweenInfo.new(0.15), {
            Size = UDim2.new(0, 68, 0, 34)
        }):Play()

        -- ⚡ 防误触核心判定：位移小于 6 像素才认定为“纯点击打开”
        if totalDragDistance < 6 then
            GlassCapsule.Visible = false
            MainFrame.Visible = true

            TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 420, 0, 250),
                Position = UDim2.new(0.5, -210, 0.5, -125)
            }):Play()
        end
    end
end)

-- 主界面拖拽逻辑
local function EnableMainDrag(guiObject)
    local dragging, dragStart, startPos
    guiObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = guiObject.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            guiObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

