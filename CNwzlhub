local function CreateTab(tabName)
    local Page = Instance.new("ScrollingFrame")
    Page.Name = tabName .. "_Page"
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = Color3.fromRGB(150, 130, 210)
    Page.Visible = FirstTab
    Page.ZIndex = 5
    Page.Parent = PagesFolder

    local PageLayout = Instance.new("UIListLayout")
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    PageLayout.Padding = UDim.new(0, 8)
    PageLayout.Parent = Page

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, 32)
    TabBtn.BackgroundColor3 = FirstTab and Color3.fromRGB(38, 35, 58) or Color3.fromRGB(16, 17, 25)
    TabBtn.BackgroundTransparency = FirstTab and 0.2 or 0.6
    TabBtn.Text = "  " .. tabName
    TabBtn.TextColor3 = FirstTab and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 130, 160)
    TabBtn.Font = Enum.Font.GothamMedium
    TabBtn.TextSize = 11
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.AutoButtonColor = false
    TabBtn.ZIndex = 5
    TabBtn.Parent = Sidebar

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = TabBtn

    local tabData = { Button = TabBtn, Page = Page }
    table.insert(Tabs, tabData)

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in ipairs(Tabs) do
            local isCurrent = (t == tabData)
            t.Page.Visible = isCurrent
            TweenService:Create(t.Button, TweenInfo.new(0.2), {
                BackgroundColor3 = isCurrent and Color3.fromRGB(38, 35, 58) or Color3.fromRGB(16, 17, 25),
                BackgroundTransparency = isCurrent and 0.2 or 0.6,
                TextColor3 = isCurrent and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(130, 130, 160)
            }):Play()
        end
    end)

    FirstTab = false
    return Page
end

